{
  "openapi": "3.0.0",
  "info": {
    "title": "Cloudyte Headless API",
    "version": "1.0.0",
    "description": "Welcome to the Cloudyte Headless API documentation!\n\n## Overview\nThis API provides full A-to-Z control of your file manager, allowing you to build custom frontends, automations, and third-party integrations.\n\n## Authentication\nAll secure endpoints require authentication via a **Developer API Key**.\n1. Generate an API Key in the web interface (Settings -> Developer API Keys).\n2. Click the **Authorize** button here and enter your key (e.g., `sk_live_...`).\n3. For your own apps, pass it in the header: `Authorization: Bearer sk_live_...`\n\n## Core Concepts\n- **Accounts**: External storage drives (Telegram, Google Drive, OneDrive) linked to your Cloudyte platform.\n- **Files**: Unified files living inside specific Accounts.\n- **Shares**: Public links generated to securely share files."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Enter your Developer API Key (e.g. sk_live_...)"
      }
    },
    "schemas": {
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "64f1b2c3d..."
          },
          "name": {
            "type": "string",
            "example": "document.pdf"
          },
          "type": {
            "type": "string",
            "example": "pdf"
          },
          "size": {
            "type": "number",
            "example": 1048576
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "isTgDrive": {
            "type": "boolean"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64f1b2c..."
          },
          "accountType": {
            "type": "string",
            "example": "tgdrive"
          },
          "name": {
            "type": "string",
            "example": "My Telegram Drive"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Detailed error message"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "summary": "Register a new user",
        "description": "Creates a new user account on the platform.",
        "tags": [
          "Auth & Public"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Registration successful"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "johndoe"
                  },
                  "password": {
                    "type": "string",
                    "example": "secret123"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login to get a JWT token",
        "description": "Authenticates a user and returns a session token. Not required if using an API Key.",
        "tags": [
          "Auth & Public"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Login successful with token"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Get current user profile",
        "description": "Retrieves the details of the currently authenticated user.",
        "tags": [
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "User profile data"
          }
        }
      }
    },
    "/api/user/api-keys": {
      "get": {
        "summary": "List API keys",
        "description": "Returns a list of all active Developer API Keys for the user.",
        "tags": [
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of API keys"
          }
        }
      },
      "post": {
        "summary": "Generate a new API key",
        "description": "Creates a new Developer API Key for programmatic access.",
        "tags": [
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns the newly generated API Key (only visible once)"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "My Custom App"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts": {
      "get": {
        "summary": "List connected accounts",
        "description": "Retrieves all storage accounts (Google, OneDrive, Telegram) connected to this user.",
        "tags": [
          "Accounts"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Array of connected accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tgdrive/register": {
      "post": {
        "summary": "Register a Telegram channel as a drive",
        "description": "Connects a Telegram channel using the bot integration to act as a limitless file drive.",
        "tags": [
          "Accounts"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channelId": {
                    "type": "string",
                    "example": "-100123456789"
                  },
                  "driveName": {
                    "type": "string",
                    "example": "Movies Drive"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/files": {
      "get": {
        "summary": "List files and folders",
        "description": "Retrieves files and folders within a specific account and optional folder.",
        "tags": [
          "Files"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "description": "The ID of the storage account",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "folderId",
            "in": "query",
            "description": "The ID of the parent folder (omit for root)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Optional search term to filter files by name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/File"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/folders": {
      "post": {
        "summary": "Create a new folder",
        "description": "Creates a new directory inside the specified account and parent folder.",
        "tags": [
          "Files"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "example": "New Folder"
                  },
                  "parentId": {
                    "type": "string",
                    "description": "ID of the parent folder or 'root'"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/upload/{accountId}": {
      "post": {
        "summary": "Upload a file",
        "description": "Uploads a file to the specified account. Supports multipart/form-data. For large files, chunking logic is handled internally for OneDrive and Telegram.",
        "tags": [
          "Files"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the storage account",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File uploaded successfully"
          }
        },
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to upload"
                  },
                  "folderId": {
                    "type": "string",
                    "description": "Target folder ID (optional)"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/download/{accountId}/{fileId}": {
      "get": {
        "summary": "Download a file stream",
        "description": "Returns the raw binary stream of the file. You can pipe this directly to the filesystem or a video player.",
        "tags": [
          "Files"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary file stream",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/move": {
      "post": {
        "summary": "Move files",
        "description": "Moves one or more files to a different folder within the same account.",
        "tags": [
          "Files"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "fileIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetFolderId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{fileId}": {
      "delete": {
        "summary": "Delete a file or folder",
        "description": "Permanently removes a file or folder from the storage account.",
        "tags": [
          "Files"
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/share": {
      "post": {
        "summary": "Create a share link",
        "description": "Generates a public URL to share a file securely with anyone.",
        "tags": [
          "Shares"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Share link generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "shareUrl": {
                      "type": "string",
                      "example": "https://.../s/AbCdEf"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "fileId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shares": {
      "get": {
        "summary": "List all active shares",
        "description": "Returns all active public share links you have created.",
        "tags": [
          "Shares"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/shares/{shareId}": {
      "delete": {
        "summary": "Revoke a share link",
        "description": "Instantly revokes a share link, preventing public access.",
        "tags": [
          "Shares"
        ],
        "parameters": [
          {
            "name": "shareId",
            "in": "path",
            "required": true,
            "description": "The ID of the share (from the end of the URL)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}