TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MONGODB_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Directory for cached file thumbnails (defaults to <os.tmpdir>/cloudyte-thumbs if unset)
THUMB_DIR=

# Phase 2 operational safeguards
# Minimum free bytes required in the temporary upload directory after an upload.
MIN_TEMP_FREE_BYTES=5368709120
# Maximum upload requests per IP in the rolling rate-limit window.
UPLOAD_REQUESTS_PER_WINDOW=30
# Set true temporarily to log MongoDB execution statistics for critical indexes.
MONGODB_INDEX_DIAGNOSTICS=false
