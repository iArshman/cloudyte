TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MONGODB_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Directory for cached file thumbnails (defaults to <os.tmpdir>/cloudyte-thumbs if unset)
THUMB_DIR=

# Phase 2 operational safeguards
# Minimum free bytes required in the temporary upload directory after an upload.
MIN_TEMP_FREE_BYTES=5368709120
# Maximum upload requests per IP in the rolling rate-limit window.
UPLOAD_REQUESTS_PER_WINDOW=30
# Set true temporarily to log MongoDB execution statistics for critical indexes.
MONGODB_INDEX_DIAGNOSTICS=false

# Phase 3/4 durable jobs and security
# Stable HMAC secret used for short-lived media URLs; required in production.
MEDIA_SIGNING_SECRET=
# Set true only when the app is behind a single trusted reverse proxy.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=
# JSON request body limit (multipart uploads use the separate 2 GB limit).
JSON_BODY_LIMIT=1mb
# Maximum retries for durable cross-account transfer jobs.
JOB_MAX_ATTEMPTS=3
